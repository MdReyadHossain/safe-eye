<Window x:Class="SafeEyes.Views.BreakOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SafeEyes.ViewModels"
        mc:Ignorable="d"
        Title="Safe Eye Break Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{Binding OverlayBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="True"
        d:DataContext="{d:DesignInstance vm:BreakOverlayViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Minimalist Pill-shaped Skip Button Style -->
        <Style x:Key="SafeEyePillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="FontFamily" Value="Segoe UI, Roboto, -apple-system, sans-serif" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="24, 4, 24, 6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="17"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#50FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Main Centered Content -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="32">

            <!-- Instruction Heading -->
            <TextBlock Text="{Binding CurrentInstruction}"
                       Foreground="#FFFFFF"
                       FontFamily="Segoe UI, Roboto, -apple-system, sans-serif"
                       FontWeight="Bold"
                       FontSize="{Binding InstructionFontSize}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       MaxWidth="900"
                       Margin="0, 0, 0, 14">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="315" Color="Black" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Countdown Timer -->
            <TextBlock Text="{Binding RemainingTimeFormatted}"
                       Foreground="#EAEAEA"
                       FontFamily="Segoe UI, Roboto, -apple-system, sans-serif"
                       FontWeight="Normal"
                       FontSize="19"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsCountdownVisible, Converter={StaticResource BoolToVis}}"
                       Margin="0, 0, 0, 22">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="315" Color="Black" Opacity="0.4" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Skip Button -->
            <Button Command="{Binding SkipCommand}"
                    Visibility="{Binding CanSkip, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource SafeEyePillButtonStyle}"
                    HorizontalAlignment="Center"
                    Content="Skip" />
        </StackPanel>
    </Grid>
</Window>
