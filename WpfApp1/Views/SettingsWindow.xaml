<Window x:Class="SafeEyes.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SafeEyes.ViewModels"
        mc:Ignorable="d"
        Title="Safe Eye Settings"
        Height="620"
        Width="740"
        MinHeight="550"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/app.ico"
        Background="#181A20"
        Foreground="#E4E6EB"
        FontFamily="Segoe UI, -apple-system, sans-serif"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="CardBackground" Color="#22252E" />
        <SolidColorBrush x:Key="BorderColor" Color="#333742" />
        <SolidColorBrush x:Key="AccentColor" Color="#3B82F6" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF" />

        <!-- TabControl Style -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Padding="16, 10"
                                Margin="0, 0, 4, 0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0, 0, 0, 2"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentColor}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0, 6, 0, 6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Modern Hyperlink Style -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource AccentColor}" />
            <Setter Property="TextDecorations" Value="None" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#60A5FA" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18, 8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D3139" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16, 8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1C22" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8, 6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>

        <!-- Modern shadcn/ui Toaster Styles -->
        <Style x:Key="ToastIconBadgeStyle" TargetType="Border">
            <!-- Default (Success) -->
            <Setter Property="Background" Value="#1A22C55E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SnackbarType}" Value="Info">
                    <Setter Property="Background" Value="#1A3B82F6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SnackbarType}" Value="Warning">
                    <Setter Property="Background" Value="#1AF59E0B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SnackbarType}" Value="Error">
                    <Setter Property="Background" Value="#1AEF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToastIconPathStyle" TargetType="Path">
            <!-- Default: Success (CheckCircle) -->
            <Setter Property="Fill" Value="#22C55E" />
            <Setter Property="Data" Value="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SnackbarType}" Value="Info">
                    <Setter Property="Fill" Value="#3B82F6" />
                    <Setter Property="Data" Value="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 12,22A10,10 0 0,0 12,2M13,17H11V11H13V17M13,9H11V7H13V9Z" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SnackbarType}" Value="Warning">
                    <Setter Property="Fill" Value="#F59E0B" />
                    <Setter Property="Data" Value="M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SnackbarType}" Value="Error">
                    <Setter Property="Fill" Value="#EF4444" />
                    <Setter Property="Data" Value="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 12,22A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M13,7H11V13H13V7M13,15H11V17H13V15Z" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SnackbarBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#27272A" />
            <Setter Property="Background" Value="#09090B" />
            <Setter Property="Padding" Value="14, 12, 12, 12" />
            <Setter Property="MinWidth" Value="320" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="16" />
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="Black" Opacity="0.55" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SnackbarType}" Value="Error">
                    <Setter Property="BorderBrush" Value="#7F1D1D" />
                </DataTrigger>

                <!-- Visibility and Smooth Slide-in / Fade Animation Trigger -->
                <DataTrigger Binding="{Binding IsSnackbarVisible}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1.0"
                                                 Duration="0:0:0.20">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0"
                                                 Duration="0:0:0.20">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0.0"
                                                 Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="16"
                                                 Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0, 0, 0, 18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Safe Eye Settings"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0, 2, 0, 0">
                    <Run Text="Native Desktop Eye-Break Reminder for Windows, powered by " />
                    <Hyperlink NavigateUri="https://squadrosoft.com"
                               RequestNavigate="OnHyperlinkRequestNavigate">
                        <Run Text="Squadrosoft" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding PreviewBreakCommand}"
                    Content="Preview Break Screen"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0, 16, 0, 0">
                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Startup and Behavior"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0, 0, 0, 12" />

                            <CheckBox IsChecked="{Binding StartWithWindows}"
                                      Content="Start Safe Eye automatically when Windows boots" />
                            <CheckBox IsChecked="{Binding StartSchedulerOnLaunch}"
                                      Content="Start break scheduler automatically when application launches" />
                            <CheckBox IsChecked="{Binding LaunchMinimizedToTray}"
                                      Content="Launch minimized to the Windows system tray" />
                            <CheckBox IsChecked="{Binding NotificationsEnabled}"
                                      Content="Enable desktop notifications for upcoming breaks" />

                            <Separator Background="{StaticResource BorderColor}" Margin="0, 16" />

                            <!-- <TextBlock Text="About &amp; Developer" -->
                            <TextBlock Text=""
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0, 0, 0, 8" />

                            <TextBlock FontSize="13"
                                       Foreground="{StaticResource TextSecondary}">
                                <Run Text="Developed by " />
                                <Hyperlink NavigateUri="https://beetcoder.com"
                                           RequestNavigate="OnHyperlinkRequestNavigate">
                                    <Run Text="Beetcoder" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Timing Tab -->
            <TabItem Header="Timing">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0, 16, 0, 0">
                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Work Interval -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Work interval (minutes):"
                                       VerticalAlignment="Center"
                                       Margin="0, 10" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding WorkIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0, 8" />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="Default: 20 min"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="14, 0" />

                            <!-- Short Break -->
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Short break duration (seconds):"
                                       VerticalAlignment="Center"
                                       Margin="0, 10" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding ShortBreakSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0, 8" />
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       Text="Default: 20 sec"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="14, 0" />

                            <!-- Long Break -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Long break duration (minutes):"
                                       VerticalAlignment="Center"
                                       Margin="0, 10" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding LongBreakMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0, 8" />
                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       Text="Default: 5 min"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="14, 0" />

                            <!-- Long Break Frequency -->
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="Work intervals before long break:"
                                       VerticalAlignment="Center"
                                       Margin="0, 10" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding WorkIntervalsBetweenLongBreaks, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0, 8" />
                            <TextBlock Grid.Row="3" Grid.Column="2"
                                       Text="Default: every 4 intervals"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="14, 0" />
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Behavior Tab -->
            <TabItem Header="Behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0, 16, 0, 0">
                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Break Skipping &amp; Strict Mode"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0, 0, 0, 8" />
                            <CheckBox IsChecked="{Binding AllowSkip}"
                                      Content="Allow skipping breaks (shows Skip button and enables Escape key)" />
                            <CheckBox IsChecked="{Binding StrictBreakMode}"
                                      Content="Strict break mode (hides Skip button, forces break to finish)" />

                            <Separator Background="{StaticResource BorderColor}" Margin="0, 14" />

                            <TextBlock Text="Smart Detection"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0, 0, 0, 8" />
                            <CheckBox IsChecked="{Binding PauseOnIdle}"
                                      Content="Pause work timer when computer is idle" />

                            <StackPanel Orientation="Horizontal" Margin="24, 4, 0, 10">
                                <TextBlock Text="Idle threshold (seconds):" VerticalAlignment="Center" Margin="0, 0, 12, 0" />
                                <TextBox Text="{Binding IdleThresholdSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            </StackPanel>

                            <CheckBox IsChecked="{Binding PauseOnFullScreen}"
                                      Content="Postpone break when running full-screen applications or games" />
                            <CheckBox IsChecked="{Binding PauseOnLockOrSleep}"
                                      Content="Pause timers when computer is locked or asleep" />

                            <Separator Background="{StaticResource BorderColor}" Margin="0, 14" />

                            <TextBlock Text="Displays"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0, 0, 0, 8" />
                            <CheckBox IsChecked="{Binding AllMonitors}"
                                      Content="Display break overlay across all connected monitors" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Appearance Tab -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0, 16, 0, 0">
                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Break Screen Appearance"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0, 0, 0, 12" />

                            <!-- Darkness Slider -->
                            <TextBlock Text="Overlay Darkness:" Margin="0, 4, 0, 4" />
                            <Grid Margin="0, 0, 0, 16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0.50" Maximum="0.98"
                                        TickFrequency="0.05"
                                        Value="{Binding OverlayDarkness}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding OverlayDarknessPercentText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" />
                            </Grid>

                            <!-- Instruction Font Size -->
                            <TextBlock Text="Instruction Font Size (px):" Margin="0, 4, 0, 4" />
                            <Grid Margin="0, 0, 0, 16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="22" Maximum="48"
                                        TickFrequency="2"
                                        Value="{Binding InstructionFontSize}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding InstructionFontSize, StringFormat={}{0:F0}px}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" />
                            </Grid>

                            <CheckBox IsChecked="{Binding ShowCountdown}"
                                      Content="Show remaining countdown timer (MM:SS) below instruction" />
                            <CheckBox IsChecked="{Binding EnableTransitions}"
                                      Content="Enable smooth fade-in transitions for break overlay" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Exercises Tab -->
            <TabItem Header="Exercises">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0, 16, 0, 0">
                    <Border Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Short Break Exercises (one per line):"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0, 0, 0, 6" />
                            <TextBox Text="{Binding ShortExercisesText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="110"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0, 0, 0, 16" />

                            <TextBlock Text="Long Break Exercises (one per line):"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0, 0, 0, 6" />
                            <TextBox Text="{Binding LongExercisesText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="110"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Validation / Status Message Banner -->
        <Border Grid.Row="2"
                Margin="0, 12, 0, 0"
                Padding="12, 8"
                CornerRadius="6"
                Background="#3B1E22"
                Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ValidationError}"
                       Foreground="#FF8080"
                       FontWeight="SemiBold"
                       FontSize="13" />
        </Border>

        <!-- Status Message Banner -->
        <Border Grid.Row="2"
                Margin="0, 12, 0, 0"
                Padding="12, 8"
                CornerRadius="6"
                Background="#1E382B"
                Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#68D391"
                       FontWeight="SemiBold"
                       FontSize="13" />
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3" Margin="0, 16, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding ResetDefaultsCommand}"
                    Content="Reset to Defaults"
                    Style="{StaticResource SecondaryButtonStyle}" />

            <Button Grid.Column="2"
                    Command="{Binding CloseCommand}"
                    Content="Close"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0, 0, 10, 0" />

            <Button Grid.Column="3"
                    Command="{Binding SaveCommand}"
                    Content="Save Settings"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>

        <!-- Floating Animated shadcn/ui Toaster Notification -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Style="{StaticResource SnackbarBorderStyle}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0, 0, 24, 72"
                Panel.ZIndex="1000">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Icon Badge (shadcn Lucide Vector Icon) -->
                <Border Grid.Column="0"
                        Style="{StaticResource ToastIconBadgeStyle}"
                        Width="26" Height="26"
                        CornerRadius="13"
                        VerticalAlignment="Top"
                        Margin="0, 1, 12, 0">
                    <Path Style="{StaticResource ToastIconPathStyle}"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <!-- Title & Description (shadcn/ui typography hierarchy) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0, 0, 8, 0">
                    <TextBlock Text="{Binding SnackbarTitle}"
                               Foreground="#FAFAFA"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Margin="0, 0, 0, 2" />
                    <TextBlock Text="{Binding SnackbarMessage}"
                               Foreground="#A1A1AA"
                               FontSize="12.5"
                               FontWeight="Normal"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Close / Dismiss Ghost Button -->
                <Button Grid.Column="2"
                        Command="{Binding DismissSnackbarCommand}"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        Width="20" Height="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="4, 1, 0, 0"
                        AutomationProperties.Name="Close">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="closeBorder"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Padding="4">
                                <Path x:Name="closePath"
                                      Data="M18,6 L6,18 M6,6 L18,18"
